			(layer "F.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 1"
				(type "prepreg")
				(thickness 0.1855)
				(material "7628 RC46%")
				(epsilon_r 4.74)
				(loss_tangent 0.02)
			)
