diff -ruN a/external/br2-external/openhw-daynight/Config.in b/external/br2-external/openhw-daynight/Config.in
--- a/external/br2-external/openhw-daynight/Config.in
+++ b/external/br2-external/openhw-daynight/Config.in
@@ -0,0 +1,5 @@
+config BR2_PACKAGE_OPENHW_DAYNIGHT
+    bool "openhw-daynight"
+    default y
+    help
+      OpenHW 캐리어 주야 전환 데몬 (LTR-329 → ICR · IR LED · ISP 모드).
diff -ruN a/external/br2-external/openhw-daynight/openhw-daynight.mk b/external/br2-external/openhw-daynight/openhw-daynight.mk
--- a/external/br2-external/openhw-daynight/openhw-daynight.mk
+++ b/external/br2-external/openhw-daynight/openhw-daynight.mk
@@ -0,0 +1,22 @@
+################################################################################
+#
+# openhw-daynight — 소스는 firmware/apps/daynight (apply-f003.sh 가 src/ 로 복사)
+#
+################################################################################
+
+OPENHW_DAYNIGHT_VERSION = 1.0
+OPENHW_DAYNIGHT_SITE = $(BR2_EXTERNAL_BR2EXT_PATH)/openhw-daynight/src
+OPENHW_DAYNIGHT_SITE_METHOD = local
+OPENHW_DAYNIGHT_LICENSE = Proprietary
+
+define OPENHW_DAYNIGHT_BUILD_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) CC="$(TARGET_CC)" CFLAGS="$(TARGET_CFLAGS)" daynight
+endef
+
+define OPENHW_DAYNIGHT_INSTALL_TARGET_CMDS
+	$(INSTALL) -D -m 0755 $(@D)/daynight $(TARGET_DIR)/usr/bin/daynight
+	$(INSTALL) -D -m 0644 $(@D)/daynight.conf $(TARGET_DIR)/etc/openhw/daynight.conf
+	$(INSTALL) -D -m 0755 $(@D)/S96daynight $(TARGET_DIR)/etc/init.d/S96daynight
+endef
+
+$(eval $(generic-package))
