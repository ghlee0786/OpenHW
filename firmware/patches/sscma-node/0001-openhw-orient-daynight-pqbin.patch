+/* OpenHW F-003: openhw-daynight writes /run/daynight/mode ("day" | "night").
+ * ISP parameters live in this process, so the PQ bin is switched here (night -> *_sdr_ir.bin). */
+#define OPENHW_DN_MODE_FILE "/run/daynight/mode"
+#define OPENHW_GC2053_IR_BIN "/mnt/cfg/param/gcore_gc2053_sdr_ir.bin"
+static pthread_t g_openhw_dn_tid;
+static volatile int g_openhw_dn_run;
+
+static void *openhw_daynight_thread(void *arg)
+{
+    int cur = -1;
+    (void)arg;
+    prctl(PR_SET_NAME, "OPENHW_DN", 0, 0, 0);
+    while (g_openhw_dn_run) {
+        char buf[16] = {0};
+        FILE *f = fopen(OPENHW_DN_MODE_FILE, "r");
+        if (f != NULL) {
+            int night;
+            if (fgets(buf, sizeof(buf), f) != NULL) {
+                night = strncmp(buf, "night", 5) == 0;
+                if (night != cur) {
+                    const char *bin = night ? OPENHW_GC2053_IR_BIN : PQ_BIN_SDR;
+                    CVI_S32 ret = app_ipcam_PQBin_Load(bin);
+                    APP_PROF_LOG_PRINT(LEVEL_INFO, "openhw daynight: %s -> %s (%#x)
+", buf, bin, ret);
+                    if (ret == CVI_SUCCESS) {
+                        cur = night;
+                    }
+                }
+            }
+            fclose(f);
+        }
+        usleep(500 * 1000);
+    }
+    return CVI_NULL;
+}
