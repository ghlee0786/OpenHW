+/* OpenHW P-003: the front DF30 is placed at 180 deg, so the image is rotated vs S401.
+ * GC2053 gets mirror+flip by default; "isp_mirror_flip = 0" in /etc/openhw/daynight.conf disables it. */
+static int openhw_mirror_flip(void) {
+    int v = 1;
+    char line[128];
+    FILE* f = fopen("/etc/openhw/daynight.conf", "r");
+    if (f == NULL) {
+        return v;
+    }
+    while (fgets(line, sizeof(line), f)) {
+        if (sscanf(line, " isp_mirror_flip = %d", &v) == 1) {
+            break;
+        }
+    }
+    fclose(f);
+    return v != 0;
+}
